[Unit]
Description=Decentralert emergency coordination API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raze
Group=raze
WorkingDirectory=/home/raze/apps/decentralert
Environment=DECENTRALERT_BIND=127.0.0.1:8181
Environment=RUST_LOG=decentralert_backend=info,tower_http=info
EnvironmentFile=-/home/raze/apps/decentralert/.env
ExecStart=/home/raze/apps/decentralert/decentralert-backend
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/raze/apps/decentralert
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target

